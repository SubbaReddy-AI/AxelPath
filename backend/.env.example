# ==========================================
# AxelPath Backend — Environment Example
# ==========================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# On Render: set all values as Environment Variables in the Dashboard.

# ==========================================
# APPLICATION
# ==========================================

APP_NAME=AxelPath API
APP_ENV=development
DEBUG=True
API_PREFIX=/api/v1

# ==========================================
# MYSQL
# ==========================================

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=AxelPath
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_ROOT_PASSWORD=your_mysql_root_password

DATABASE_URL=mysql+pymysql://root:your_mysql_password@mysql:3306/AxelPath?charset=utf8mb4

# ==========================================
# SECURITY
# ==========================================

SECRET_KEY=your_long_random_secret_key_min_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==========================================
# FRONTEND / ADMIN ORIGINS (CORS)
# ==========================================
# Override any of these in production Render env vars if they change.

FRONTEND_URL=https://www.axelpath.in
APEX_FRONTEND_URL=https://axelpath.in
OLD_FRONTEND_URL=https://axelpath.vercel.app
ADMIN_URL=https://axelpath-admin.vercel.app

# Legacy domains (still supported)
LEGACY_FRONTEND_URL=https://qodekraft.in
LEGACY_WWW_FRONTEND_URL=https://www.qodekraft.in

# Local development (overrides production values locally)
LOCAL_FRONTEND_URL=http://localhost:5173
LOCAL_ADMIN_URL=http://localhost:5174

# ==========================================
# FILE UPLOAD
# ==========================================

UPLOAD_DIR=app/uploads
MAX_UPLOAD_SIZE_MB=25

# ==========================================
# EMAIL (SMTP / Gmail App Password)
# ==========================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

# ==========================================
# ADMIN ACCOUNT
# ==========================================

ADMIN_EMAIL=
ADMIN_PASSWORD=

# ==========================================
# RAZORPAY
# ==========================================
# Test credentials  : rzp_test_...  (use in dev / staging)
# Live credentials  : rzp_live_...  (set ONLY in the Render production env)
# NEVER commit real credentials.
#
# To go live:
#   1. Log into https://dashboard.razorpay.com
#   2. Generate live API keys under Settings → API Keys
#   3. Set up a webhook pointing to:
#      https://qodekraft.onrender.com/api/v1/course-registrations/webhook
#      Subscribe to event: payment.captured
#   4. Copy the webhook secret shown in the Dashboard
#   5. Set the three variables below in Render → Environment

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_BASE_URL=https://api.razorpay.com/v1

# ==========================================
# GOOGLE DRIVE (future integration)
# ==========================================
# Leave empty. Configure manually when Google Drive structure is provided.

GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_FOLDER_URL=

# ==========================================
# GOOGLE SHEETS (future integration)
# ==========================================

GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=Student Registrations