# ==========================================
# AxelPath ENVIRONMENT EXAMPLE
# ==========================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

APP_NAME=AxelPath API
APP_ENV=development
DEBUG=True
API_PREFIX=/api/v1

# ==========================================
# MYSQL
# ==========================================

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=AxelPath
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_ROOT_PASSWORD=your_mysql_root_password

DATABASE_URL=mysql+pymysql://root:your_mysql_password@mysql:3306/AxelPath?charset=utf8mb4

# ==========================================
# SECURITY
# ==========================================

SECRET_KEY=your_long_random_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==========================================
# FRONTEND / ADMIN
# ==========================================

FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# ==========================================
# FILE UPLOAD
# ==========================================

UPLOAD_DIR=app/uploads
MAX_UPLOAD_SIZE_MB=25

# ==========================================
# EMAIL (SMTP)
# ==========================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

# ==========================================
# ADMIN
# ==========================================

ADMIN_EMAIL=
ADMIN_PASSWORD=

# ==========================================
# RAZORPAY
# ==========================================
# Add credentials when available via Render environment variables.
# NEVER commit real Razorpay secrets.
RAZORPAY_BASE_URL=https://api.razorpay.com/v1
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ==========================================
# GOOGLE DRIVE (future integration)
# ==========================================
# Leave empty. Configure manually when Google Drive structure is provided.

GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_FOLDER_URL=